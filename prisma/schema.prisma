generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Admin {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String
  plainPassword String?
  name          String
  role          String   @default("admin")
  createdAt     DateTime @default(now())
}

model Lead {
  id         String   @id @default(cuid())
  name       String
  email      String
  cnic       String?
  phone      String?
  company    String?
  position   String?
  message    String?
  cvFileName String?
  cvPath     String?
  status     String   @default("new")
  createdAt  DateTime @default(now())

  // Careers application fields. All nullable so leads from the contact form and
  // applications submitted before these existed stay valid as they are.
  referenceId   String? @unique
  // Generated by the browser per application, so a retried submit returns the
  // original reference instead of filing the application twice.
  submissionKey String? @unique
  vacancyId     String?
  // recruitment | hr-employment-check | internal-movement
  queue         String?
  // JSON array: possible-duplicate, previous-employee, current-employee
  flags         String? @db.Text
  // JSON: { answers, summary, vacancy, duplicates }
  details       String? @db.Text
  // JSON: { channel, campaign, adId, medium, landing, heardAbout, referrer }
  source        String? @db.Text
  // Set when "Download New Leads" includes this row; null means still new.
  exportedAt      DateTime?
  // Set when "Download New CVs" includes this CV; null means still new.
  cvDownloadedAt  DateTime?
}

// A role HR is currently hiring for. Only active rows are listed on the careers
// form; list columns hold JSON arrays like Campaign.locations.
model Vacancy {
  id              String   @id @default(cuid())
  title           String
  department      String
  roleGroups      String   @default("[]")
  branches        String   @default("[]")
  remoteAllowed   Boolean  @default(false)
  // Set when the vacancy is for one named campaign, so applicants are not asked.
  campaign        String?
  workingDays     String?
  workingHours    String?
  workArrangement String?
  cvRequired      Boolean  @default(false)
  // Replaces the generic specialist question for this vacancy when set.
  customQuestion  String?  @db.Text
  description     String?  @db.Text
  order           Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Campaign {
  id          String   @id @default(cuid())
  title       String
  description String?
  icon        String   @default("briefcase")
  // The first branch of `locations`, kept in step on every write. Retained so a
  // reader that predates multi-branch hiring still gets a sensible answer.
  location    String   @default("Shamsabad Office")
  // Every branch running this campaign, as a JSON array of office names — the
  // same shape and column type Blog.tags uses, so it can carry a default that
  // MySQL would refuse on TEXT. A column was added rather than the existing one
  // being replaced, so no row had to be rewritten to introduce it.
  locations   String   @default("[]")
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Blog {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  excerpt         String?   @db.Text
  content         String    @db.Text
  image           String?
  imageAlt        String?
  // Legacy JSON string of tag names; kept in sync with BlogTagOnBlog for older readers.
  tags            String    @default("[]")
  format          String    @default("standard")
  metaTitle       String?
  metaDescription String?   @db.Text
  order           Int       @default(0)
  isPublished     Boolean   @default(true)
  // draft | published | scheduled
  status          String    @default("published")
  publishedAt     DateTime?
  scheduledAt     DateTime?
  categoryId      String?
  category        BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tagLinks        BlogTagOnBlog[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([categoryId])
  @@index([status, scheduledAt])
}

model BlogCategory {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  description     String?  @db.Text
  image           String?
  imageAlt        String?
  metaTitle       String?
  metaDescription String?  @db.Text
  isActive        Boolean  @default(true)
  order           Int      @default(0)
  blogs           Blog[]
  tagLinks        BlogCategoryTag[]
  redirects       BlogCategoryRedirect[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model BlogCategoryRedirect {
  id         String       @id @default(cuid())
  oldSlug    String       @unique
  categoryId String
  category   BlogCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())
}

model BlogTag {
  id         String            @id @default(cuid())
  name       String
  slug       String            @unique
  blogs      BlogTagOnBlog[]
  categories BlogCategoryTag[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
}

model BlogCategoryTag {
  categoryId String
  tagId      String
  category   BlogCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  tag        BlogTag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([categoryId, tagId])
}

model BlogTagOnBlog {
  blogId String
  tagId  String
  blog   Blog    @relation(fields: [blogId], references: [id], onDelete: Cascade)
  tag    BlogTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([blogId, tagId])
}

model Office {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  address      String   @db.Text
  phone        String?
  email        String?
  hours        String?
  city         String?
  country      String   @default("Pakistan")
  image        String?
  mapEmbedUrl  String?  @db.Text
  order        Int      @default(0)
  isActive     Boolean  @default(true)
  isHeadOffice Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model MediaItem {
  id         String   @id @default(cuid())
  title      String
  alt        String?
  src        String
  kind       String   @default("image")
  section    String   @default("gallery")
  category   String   @default("Events")
  order      Int      @default(0)
  isFeatured Boolean  @default(false)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
