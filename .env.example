DATABASE_URL="mysql://root@localhost:3306/balitech"

# JWT — required for admin login tokens (use a long random string in production)
JWT_SECRET="your-secret-key-here"
JWT_EXPIRES_IN="7d"
JWT_ISSUER="balitech"
JWT_AUDIENCE="balitech-admin"

# Permanent API key for server-to-server integrations (CRM). Sent as
# "Authorization: Bearer <key>". Never expires; change it to revoke. Min 32 chars.
CRM_API_TOKEN=""

ADMIN_EMAIL="admin@balitech.com"
ADMIN_PASSWORD="admin123"

# Google Analytics 4 (optional). Example: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Meta (Facebook) Pixel (optional). Example: 1528153738658754
NEXT_PUBLIC_META_PIXEL_ID="1528153738658754"

# Titan SMTP (HR mailbox). Password lives only in server/local .env — never commit it.
SMTP_HOST="smtp.titan.email"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="humanresource@balitech.org"
SMTP_PASS=""
SMTP_FROM="humanresource@balitech.org"
SMTP_TO="humanresource@balitech.org"
